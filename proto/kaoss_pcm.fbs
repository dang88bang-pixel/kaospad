// KPCM-PCM-Übertragung der Kaoss-Aktionskette (Phase 3: FlatBuffers für PCM-Pfade).
//
// -- REAL-IMPLEMENTATION 2026-09-12 (Audit Phase 3)
// Vereinbarung: FlatBuffers für die PCM-Pfade (KPCM-Capture/Loopback-Pipes),
// JSON bleibt für die Steuerkanäle (KCTL, /api/*).
//
// Rahmen auf dem Draht (Unix-Datagramm bzw. TCP-Framing der Pipe 8081):
//   b"KPCF" | <FlatBuffer-Puffer, little-endian, root_type PcmBlock>
// Das 4-Byte-Präfix unterscheidet den Frame von b"KPCM" (rohes Float32) und
// b"KCTL" (JSON-Steuerkanal); siehe engines/audio_capture.py.
//
// Referenz-Codec: engines/kpcm_flatbuffers.py (ohne externe Abhängigkeit).
// Gegenprüfung: tests/flatbuffers_pcm_test.py erzeugt mit `flatc --python`
// aus genau dieser Datei den offiziellen Codec und kreuzdecodiert beide
// Richtungen.

namespace Kaoss.Ipc;

/// Ein PCM-Block der Float32-Pipe (mono, nicht interleavt).
table PcmBlock {
  /// Abtastrate in Hz (z. B. 48000).
  sample_rate_hz: uint32 = 48000;
  /// Anzahl der Samples pro Kanal in diesem Block.
  frames: uint32 = 0;
  /// Kanäle; die Kette rechnet mono.
  channels: uint16 = 1;
  /// Fortlaufende Blocknummer des Senders (0-basiert, Wrap erlaubt).
  seq: uint32 = 0;
  /// Herkunft: "ipc_mic" | "ipc_uac2" | "ipc_ble" | "client_pcm".
  source: string;
  /// Sample-Format, derzeit ausschließlich "float32" (−1.0 … 1.0).
  /// Kein Schema-Default: FlatBuffers erlaubt keine Defaults für Strings/Vektoren;
  /// der semantische Default ("float32") liegt im Codec (`DEFAULTS`).
  format: string;
  /// Aufnahmezeitpunkt des Blocks in Millisekunden (Sender-Uhr).
  t_ms: double = 0.0;
  /// Die Samples selbst, little-endian float32.
  samples: [float];
  /// SHA-256 der Sample-Bytes als Hex (erste 16 Zeichen) – Loopback-Vergleich.
  checksum: string;
}

root_type PcmBlock;
